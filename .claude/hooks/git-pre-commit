#!/bin/bash
# Git pre-commit hook: quality gate + data protection
# Install: cp .claude/hooks/git-pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: make install-hooks

# =============================================================================
# PART 1: Data Protection — block large files, binary data, and PDFs
# =============================================================================

MAX_SIZE_KB=5120  # 5 MB

# Blocked extensions (binary data formats and PDFs)
BLOCKED_EXT='\.dta$|\.sav$|\.parquet$|\.feather$|\.arrow$|\.rds$|\.RData$|\.Rdata$|\.xlsx$|\.xls$|\.pdf$|\.zip$|\.gz$|\.tar$|\.7z$|\.h5$|\.hdf5$|\.sqlite$|\.db$'

ALL_STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
BLOCKED=0

for file in $ALL_STAGED; do
  if [ ! -f "$file" ]; then
    continue
  fi

  # Check blocked extensions
  if echo "$file" | grep -qE "$BLOCKED_EXT"; then
    echo "BLOCKED: $file — binary/PDF files cannot be committed"
    echo "  Move large data to RESEARCH_DATA (see scripts/src/paths.py)"
    BLOCKED=1
    continue
  fi

  # Check file size
  SIZE_KB=$(du -k "$file" | cut -f1)
  if [ "$SIZE_KB" -gt "$MAX_SIZE_KB" ]; then
    echo "BLOCKED: $file — ${SIZE_KB}KB exceeds ${MAX_SIZE_KB}KB limit"
    echo "  Move large data to RESEARCH_DATA (see scripts/src/paths.py)"
    BLOCKED=1
  fi
done

if [ "$BLOCKED" -eq 1 ]; then
  echo ""
  echo "Commit blocked by data protection. Use --no-verify to override (not recommended)."
  exit 1
fi

# =============================================================================
# PART 2: Quality Gate — score staged .tex/.R/.py/.do files
# =============================================================================

QUALITY_SCRIPT="scripts/src/Python/quality_score.py"
THRESHOLD=80

# Skip infrastructure files
SKIP_FILES=(
  "scripts/src/Python/init_project.py"
  "scripts/src/Python/quality_score.py"
)

# Get staged files matching scorable extensions
STAGED=$(echo "$ALL_STAGED" | grep -E '\.(tex|R|py|do)$')

if [ -z "$STAGED" ]; then
  exit 0
fi

# Filter out skipped files
FILES=""
for f in $STAGED; do
  skip=false
  for s in "${SKIP_FILES[@]}"; do
    if [ "$f" = "$s" ]; then
      skip=true
      break
    fi
  done
  if [ "$skip" = false ]; then
    FILES="$FILES $f"
  fi
done

if [ -z "$FILES" ]; then
  exit 0
fi

# Check if quality_score.py exists
if [ ! -f "$QUALITY_SCRIPT" ]; then
  echo "Warning: $QUALITY_SCRIPT not found, skipping quality gate"
  exit 0
fi

FAILED=0
for file in $FILES; do
  if [ ! -f "$file" ]; then
    continue
  fi

  RESULT=$(python3 "$QUALITY_SCRIPT" "$file" --json 2>/dev/null)
  SCORE=$(echo "$RESULT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['score'])" 2>/dev/null)

  if [ -n "$SCORE" ] && [ "$SCORE" -lt "$THRESHOLD" ] 2>/dev/null; then
    echo "BLOCKED: $file scores $SCORE/100 (threshold: $THRESHOLD)"
    FAILED=1
  fi
done

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "Commit blocked by quality gate. Fix issues above or use --no-verify to skip."
  exit 1
fi

exit 0
